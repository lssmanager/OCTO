# .env.local.example -- local-only template. Never use for deployment.
# Copy to .env for local development only and replace all placeholder secrets.

NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
RUNTIME_WORKER_PORT=8001

POSTGRES_USER=octo
POSTGRES_PASSWORD=local-postgres-password-change-me
POSTGRES_DB=octo
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

RUNTIME_POSTGRES_USER=octo_runtime
RUNTIME_POSTGRES_PASSWORD=local-runtime-postgres-password-change-me
RUNTIME_DATABASE_URL=postgresql://${RUNTIME_POSTGRES_USER}:${RUNTIME_POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

REDIS_PASSWORD=local-redis-password-change-me
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

JWT_SECRET=local-jwt-secret-change-me-min-32-chars
INTERNAL_SECRET=local-internal-secret-change-me-32-chars

LITELLM_MASTER_KEY=sk-local-change-me
OPENAI_API_KEY=sk-local-change-me
LITELLM_BASE_URL=http://localhost:4000

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-qdrant-key-change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=local-minio-access-change-me
MINIO_SECRET_KEY=local-minio-secret-change-me
