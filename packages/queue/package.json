    "ioredis": "5.6.1"
  },
  "devDependencies": {
    "@octo/config": "workspace:*",
    "@types/node": "22.0.0",
    "rimraf": "5.0.0",
    "tsup": "8.0.0",
    "typescript": "5.4.0",
    "vitest": "3.1.1"
  }
}
