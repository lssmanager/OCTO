{
  "name": "@octo/queue",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --external @octo/contracts --external @octo/observability --external ioredis --external bullmq --external @opentelemetry/api",
    "dev": "tsup src/index.ts --format cjs --watch --external @octo/contracts --external @octo/observability --external ioredis --external bullmq --external @opentelemetry/api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@octo/contracts": "workspace:*",
    "@octo/observability": "workspace:*",
    "bullmq": "5.77.7",
    "ioredis": "5.6.1",
    "@opentelemetry/api": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "rimraf": "5.0.0",
    "tsup": "8.5.1",
    "typescript": "5.4.2",
    "vitest": "3.2.4"
  }
}
