{
  "name": "@octo/queue",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external @octo/contracts --external @octo/observability --external ioredis --external bullmq --external @opentelemetry/api",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --clean --external @octo/contracts --external @octo/observability --external ioredis --external bullmq --external @opentelemetry/api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@octo/contracts": "workspace:*",
    "@octo/observability": "workspace:*",
    "bullmq": "5.78.0",
    "ioredis": "5.11.0",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
