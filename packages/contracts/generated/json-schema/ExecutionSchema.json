{
  "$ref": "#/definitions/ExecutionSchema",
  "definitions": {
    "ExecutionSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "agentVersionId": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "queued",
            "dispatched",
            "running",
            "waiting_tool",
            "waiting_human",
            "retrying",
            "retry_scheduled",
            "suspended",
            "reclaimable",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "version": {
          "type": "integer"
        },
        "inputJson": {
          "type": "object",
          "additionalProperties": {}
        },
        "outputJson": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptCount": {
          "type": "integer"
        },
        "reclaimCount": {
          "type": "integer"
        },
        "leaseOwner": {
          "type": [
            "string",
            "null"
          ]
        },
        "leaseExpiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancellationRequestedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "budgetSnapshotJson": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "contextSnapshotJson": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "agentId",
        "agentVersionId",
        "state",
        "version",
        "inputJson",
        "attemptCount",
        "reclaimCount",
        "createdBy",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
