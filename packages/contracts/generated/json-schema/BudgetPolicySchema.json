{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxUsdPerRun": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "maxUsdPerDay": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "minReservedCostUsd": {
      "default": "0.000001",
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "currentSpendUsd": {
      "default": "0",
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "onExhaust": {
      "default": "fail",
      "type": "string",
      "enum": [
        "fail",
        "block",
        "warn",
        "require_approval"
      ]
    },
    "hardStop": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "maxUsdPerRun",
    "maxUsdPerDay"
  ],
  "additionalProperties": false,
  "title": "BudgetPolicySchema"
}
