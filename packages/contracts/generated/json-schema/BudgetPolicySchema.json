{
  "$ref": "#/definitions/BudgetPolicySchema",
  "definitions": {
    "BudgetPolicySchema": {
      "type": "object",
      "properties": {
        "maxUsdPerRun": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "maxUsdPerDay": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "hardStop": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "maxUsdPerRun",
        "maxUsdPerDay"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
