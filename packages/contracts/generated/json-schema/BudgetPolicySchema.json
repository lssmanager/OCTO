{
  "$ref": "#/definitions/BudgetPolicySchema",
  "definitions": {
    "BudgetPolicySchema": {
      "type": "object",
      "properties": {
        "maxUsdPerRun": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "maxUsdPerDay": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "minReservedCostUsd": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "default": "0.000001"
        },
        "currentSpendUsd": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "default": "0"
        },
        "onExhaust": {
          "type": "string",
          "enum": [
            "fail",
            "block",
            "warn",
            "require_approval"
          ],
          "default": "fail"
        },
        "hardStop": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "maxUsdPerRun",
        "maxUsdPerDay"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
