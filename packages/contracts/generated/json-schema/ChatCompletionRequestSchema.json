{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tenantId": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "agentId": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "toolCallId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "temperature": {
      "default": 0.2,
      "type": "number"
    },
    "maxOutputTokens": {
      "default": 2048,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "stream": {
      "default": false,
      "type": "boolean"
    },
    "timeoutMs": {
      "default": 90000,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tools": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              }
            },
            "required": [
              "name",
              "description",
              "inputSchema"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "toolChoice": {
      "default": "auto",
      "type": "string",
      "enum": [
        "none",
        "auto",
        "required"
      ]
    },
    "providerParams": {
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "promptCache": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "strategy": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "provider",
                "semantic",
                "provider_then_semantic"
              ]
            },
            "cacheKey": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "providerBreakpoints": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "semanticSimilarityThreshold": {
              "default": 0.92,
              "type": "number"
            },
            "ttlSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoningEffort": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "outputSchema": {
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "routingStrategy": {
      "default": "default",
      "type": "string",
      "enum": [
        "default",
        "least-busy",
        "latency-based",
        "cost-based"
      ]
    }
  },
  "required": [
    "tenantId",
    "executionId",
    "agentId",
    "model",
    "messages"
  ],
  "additionalProperties": false,
  "title": "ChatCompletionRequestSchema"
}
