{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "toolCalls": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "finishReason": {
      "type": "string",
      "enum": [
        "stop",
        "tool_calls",
        "length",
        "content_filter",
        "error"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalTokens": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoningTokens": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cachedInputTokens": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "estimatedCostUsd": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        }
      },
      "required": [
        "provider",
        "model",
        "estimatedCostUsd"
      ],
      "additionalProperties": false
    },
    "raw": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "content",
    "finishReason",
    "usage",
    "raw"
  ],
  "additionalProperties": false,
  "title": "ChatCompletionResponseSchema"
}
