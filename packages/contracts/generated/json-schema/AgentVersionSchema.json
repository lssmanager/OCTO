{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "agentId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "configJson": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "instructions": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "modelPolicy": {
          "type": "object",
          "properties": {
            "primaryModel": {
              "type": "string"
            },
            "fallbackModels": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fallbackChain": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedModels": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "registeredModels": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "temperature": {
              "default": 0.2,
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "maxOutputTokens": {
              "default": 2048,
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "primaryModel"
          ],
          "additionalProperties": false
        },
        "toolPolicy": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requireApprovalFor": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "allow"
          ],
          "additionalProperties": false
        },
        "budgetPolicy": {
          "type": "object",
          "properties": {
            "maxUsdPerRun": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            },
            "maxUsdPerDay": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            },
            "minReservedCostUsd": {
              "default": "0.000001",
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "currentSpendUsd": {
              "default": "0",
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "onExhaust": {
              "default": "fail",
              "type": "string",
              "enum": [
                "fail",
                "block",
                "warn",
                "require_approval"
              ]
            },
            "hardStop": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "maxUsdPerRun",
            "maxUsdPerDay"
          ],
          "additionalProperties": false
        },
        "executionTimeoutMs": {
          "default": 900000,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "instructions",
        "workspaceId",
        "modelPolicy",
        "toolPolicy",
        "budgetPolicy"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "tenantId",
    "agentId",
    "version",
    "configJson",
    "createdAt"
  ],
  "additionalProperties": false,
  "title": "AgentVersionSchema"
}
