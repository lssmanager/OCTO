{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "stepIndex": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "enum": [
        "input",
        "loop",
        "tool",
        "approval",
        "reclaim",
        "final"
      ]
    },
    "parentCheckpointId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stateJson": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "channelVersions": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "versionsSeen": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "type": "object",
        "properties": {},
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "metadataJson": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "executionId",
    "tenantId",
    "stepIndex",
    "source",
    "stateJson",
    "channelVersions",
    "versionsSeen",
    "metadataJson",
    "createdAt"
  ],
  "additionalProperties": false,
  "title": "ExecutionCheckpointSchema"
}
