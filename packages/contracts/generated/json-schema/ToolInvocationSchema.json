{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "stepId": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "toolKind": {
      "type": "string",
      "enum": [
        "builtin_sync",
        "builtin_async",
        "mcp_stdio",
        "mcp_http"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "EXECUTING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "PENDING_ASYNC",
        "CANCELLED"
      ]
    },
    "argsJson": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "resultJson": {
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorMessage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "approvalId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotencyKey": {
      "type": "string"
    },
    "durationMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "tenantId",
    "executionId",
    "stepId",
    "toolName",
    "toolKind",
    "status",
    "argsJson",
    "requiresApproval",
    "idempotencyKey",
    "startedAt"
  ],
  "additionalProperties": false,
  "title": "ToolInvocationSchema"
}
