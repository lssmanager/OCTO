{
  "name": "@octo/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "OCTO shared contracts, interfaces, and type definitions.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schemas/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts src/schemas/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --testTimeout=60000",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/json-schema": "7.0.15",
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "rimraf": "6.1.3"
  },
  "files": [
    "dist"
  ]
}
