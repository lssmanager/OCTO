{
  "name": "@octo/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "OCTO shared contracts, interfaces, and type definitions.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schemas/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts src/schemas/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "zod": "3.24.0"
  },
  "devDependencies": {
    "@types/json-schema": "7.0.0",
    "@types/node": "22.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
