{
  "name": "@octo/sdk-abstractions",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@octo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@octo/contracts": "workspace:*",
    "@types/node": "25.9.1",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
