{
  "name": "@octo/database",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "require": "./dist/migrate.js",
      "import": "./dist/migrate.mjs"
    }
  },
  "scripts": {
    "build": "pnpm run build:self",
    "build:deps": "pnpm --filter '@octo/database^...' build",
    "build:self": "tsup src/index.ts src/migrate.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm run build:deps && pnpm run build:self && node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@octo/config": "workspace:*",
    "@types/node": "25.9.1",
    "drizzle-kit": "0.31.10",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "module": "./dist/index.mjs",
  "files": [
    "dist",
    "migrations"
  ]
}
