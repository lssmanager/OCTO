{
  "name": "@octo/database",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./migrate": {
      "require": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts --format cjs --dts",
    "dev": "tsup src/index.ts --format cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.5",
    "@octo/events": "workspace:*"
  },
  "devDependencies": {
    "@octo/config": "workspace:*",
    "@types/node": "22.15.21",
    "drizzle-kit": "0.30.6",
    "rimraf": "5.0.10",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
