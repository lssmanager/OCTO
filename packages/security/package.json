{
  "name": "@octo/security",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @nestjs/common --external @nestjs/core --external @nestjs/core/guards --external reflect-metadata --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external @nestjs/common --external @nestjs/core --external @nestjs/core/guards --external reflect-metadata --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0"
  },
  "dependencies": {
    "@octo/observability": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.24",
    "@octo/config": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
