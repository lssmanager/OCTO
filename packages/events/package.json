{
  "name": "@octo/events",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --external @octo/contracts",
    "dev": "tsup src/index.ts --format cjs --watch --external @octo/contracts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@octo/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "rimraf": "5.0.0",
    "tsup": "8.5.0",
    "typescript": "5.4.2",
    "vitest": "3.2.4"
  }
}
