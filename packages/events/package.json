{
  "name": "@octo/events",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run build:self",
    "build:deps": "pnpm --filter '@octo/events^...' build",
    "build:self": "tsup src/index.ts --format cjs,esm --dts --external @octo/contracts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external @octo/contracts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@octo/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ]
}
