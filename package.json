{
  "name": "octo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @octo/database db:generate",
    "db:migrate": "pnpm --filter @octo/database db:migrate",
    "db:studio": "pnpm --filter @octo/database db:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "cross-env": "^7.0.3"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^10.0.0",
      "glob": "^11.0.0",
      "source-map": "0.7.4"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
