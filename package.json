{
  "name": "octo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:boundaries": "eslint --config eslint.config.js 'packages/**/*.ts' 'apps/**/*.ts' --max-warnings 0",
    "format": "prettier --write .",
    "test": "turbo test",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @octo/database db:generate",
    "db:migrate": "pnpm --filter @octo/database db:migrate",
    "db:studio": "pnpm --filter @octo/database db:studio",
    "contracts:build": "pnpm --filter @octo/contracts build && node scripts/generate-json-schema.mjs",
    "contracts:python": "python3 scripts/generate_pydantic_models.py",
    "contracts:check": "pnpm contracts:build && pnpm contracts:python && git diff --exit-code -- packages/contracts/generated apps/runtime-worker/app/contracts/generated",
    "contracts:validate": "pnpm contracts:build && pnpm contracts:python && pnpm exec tsx scripts/validate-contract-roundtrip.ts && pnpm contracts:check",
    "observability:check-rules": "promtool check rules infra/prometheus/rules/octo-f1.yml",
    "observability:test-rules": "promtool test rules infra/prometheus/rules/octo-f1-test.yml",
    "observability:check-silences": "tsx scripts/observability/check-alert-silences.ts",
    "formatcheck": "prettier --check .",
    "testunit": "turbo run test --filter=@octo/contracts --filter=@octo/api --filter=@octo/database --filter=@octo/events --filter=@octo/runtime-state -- --coverage",
    "testintegration": "vitest run packages/database/src/f1-database.integration.test.ts apps/api/src/**/*.integration.test.ts",
    "arch:check": "bash scripts/arch-check.sh",
    "docker:build:api": "docker build -f docker/api.Dockerfile -t octo/api:sha-local --build-arg VERSION=local --build-arg REVISION=local --build-arg CREATED=local .",
    "docker:build:runtime-worker": "docker build -f docker/runtime-worker.Dockerfile -t octo/runtime-worker:sha-local --build-arg VERSION=local --build-arg REVISION=local --build-arg CREATED=local .",
    "docker:build:scheduler-worker": "docker build -f docker/scheduler-worker.Dockerfile -t octo/scheduler-worker:sha-local --build-arg VERSION=local --build-arg REVISION=local --build-arg CREATED=local .",
    "docker:build:migrate": "docker build -f docker/migrate.Dockerfile -t octo/migrate:sha-local --build-arg VERSION=local --build-arg REVISION=local --build-arg CREATED=local .",
    "docker:build:f1": "pnpm docker:build:api && pnpm docker:build:runtime-worker && pnpm docker:build:scheduler-worker && pnpm docker:build:migrate",
    "docker:verify-hardening": "bash scripts/verify-docker-hardening.sh",
    "f1:verify": "bash scripts/f1-verify.sh --fast",
    "contracts:generate": "pnpm contracts:build && pnpm contracts:python",
    "test:outbox": "turbo run test --filter=@octo/events --filter=@octo/api -- outbox",
    "f1:close-gate": "bash scripts/f1-verify.sh --close",
    "test:tenant-isolation": "vitest run apps/api/src/security/tenant-isolation.integration.test.ts packages/database/src/f1-database.integration.test.ts",
    "f1:tenant-isolation": "pnpm test:tenant-isolation",
    "test:observability": "vitest run apps/api/src/ops/f1-observability.integration.test.ts apps/api/src/ops/ops-v1.service.spec.ts",
    "f1:observability": "pnpm test:observability",
    "security:vitest": "node scripts/verify-vitest-security.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.59.4",
    "@vitest/coverage-v8": "4.1.8",
    "ajv": "6.14.0",
    "cross-env": "7.0.3",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "tsx": "4.22.4",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod-to-json-schema": "3.24.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
