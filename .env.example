# .env.example
# Copiar a .env y completar los valores antes de `docker compose up`.
# NUNCA hacer commit de .env con valores reales.
# Este archivo SI va a git — es la fuente de verdad de las variables requeridas.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=octo
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=octo
DATABASE_URL=postgresql://octo:change_me_in_production@postgres:5432/octo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API (NestJS Control Plane) ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change_me_in_production_min_32_chars
BUILD_VERSION=0.0.1-f0
BUILD_COMMIT=local
BUILD_PHASE=F0

# ── Runtime Worker (FastAPI) ─────────────────────────────────────────────────
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_LOG_LEVEL=info
API_URL=http://api:3001

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=octo-api
LOG_LEVEL=info

# ── LLM Providers (runtime-worker) ───────────────────────────────────────────
# Al menos uno debe estar configurado
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Grafana (observabilidad) ──────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
