# .env.example -- COMMIT THIS FILE. Never commit .env
# Copy to .env for local development. Never put real values here.
#
# ADR-0016: Secrets are injected at runtime, never at build time.
# In Coolify: Service -> Environment Variables -> Secret (encrypted)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://octo:octo@localhost:5432/octo

# ── Redis / BullMQ (transient queue only -- not source of truth) ───────────────
REDIS_URL=redis://localhost:6379

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
RUNTIME_WORKER_PORT=8001

# ── OTel / Observability ──────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=octo-api
OTEL_ENVIRONMENT=development

# ── LLM Provider (via LiteLLM -- never raw vendor SDK) ────────────────────────
LITELLM_MASTER_KEY=sk-change-me
OPENAI_API_KEY=sk-change-me

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars

# ── Qdrant (vector memory) ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── MinIO (blob storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
