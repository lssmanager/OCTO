# =============================================================================
# OCTO — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is in .gitignore.
#
# Secret generation:
#   JWT_SECRET:         openssl rand -base64 32
#   RUNTIME_API_SECRET: openssl rand -hex 32
#   ENCRYPTION_KEY:     openssl rand -base64 32
#   LITELLM_MASTER_KEY: openssl rand -hex 16
#
# See docs/adr/F0-016-env-config-strategy.md for full strategy.
# =============================================================================

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://octo:CHANGE_ME@localhost:5432/octo
DB_POOL_MAX=20
POSTGRES_USER=octo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=octo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant (vector DB — memory layer) ────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── MinIO (artifact / execution storage) ─────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=octo

# ── LiteLLM Gateway ───────────────────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
# SECURITY: min 16 chars. Generate: openssl rand -hex 16
LITELLM_MASTER_KEY=CHANGE_ME_min_16_chars

# LLM provider keys go in litellm/config.yaml — NOT here
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# ── API (NestJS Control Plane) ────────────────────────────────────────────────
PORT=3001

# SECURITY: min 32 chars. Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand
JWT_EXPIRES_IN=24h

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── Runtime Worker ↔ API inter-service authentication ─────────────────────────
# SECURITY: min 32 chars. Generate: openssl rand -hex 32
# RUNTIME_API_SECRET (API side) must match API_INTERNAL_SECRET (worker side)
RUNTIME_WORKER_URL=http://localhost:8001
RUNTIME_API_SECRET=CHANGE_ME_min_32_chars_hex

# ── Runtime Worker (FastAPI — Execution Plane) ────────────────────────────────
# API_INTERNAL_SECRET must match RUNTIME_API_SECRET above
API_INTERNAL_SECRET=CHANGE_ME_min_32_chars_hex
LITELLM_URL=http://localhost:4000
# SECURITY: min 16 chars. Same value as LITELLM_MASTER_KEY above
LITELLM_API_KEY=CHANGE_ME_min_16_chars
WORKER_CONCURRENCY=4
EXECUTION_TIMEOUT_SECS=300
MAX_EXECUTION_TIMEOUT_MS=300000

# ── Web (Next.js Dashboard) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=octo-api
OTEL_LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────────────────
# SECURITY: exactly 32 bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_exactly_32_bytes_minimum_!

# ── Build info (injected by CI — do not change manually) ─────────────────────
BUILD_VERSION=0.0.1-f0
BUILD_COMMIT=local
BUILD_PHASE=F0
