# .env.example
# Fuente de verdad de TODAS las variables requeridas por el stack OCTO.
# Copiar a .env y completar los valores antes de `docker compose up`.
# NUNCA hacer commit de .env con valores reales.
#
# Para Coolify: copiar cada variable a Configuration → Environment Variables.
# Coolify inyecta estas variables en el compose en runtime.
#
# Derivado de:
#   packages/config/src/schema/api.ts      (Zod — NestJS API)
#   packages/config/src/schema/runtime.ts  (Zod — documentación Python)
#   apps/runtime-worker/src/config.py      (pydantic-settings)

# ════════════════════════════════════════════════════════════════
# INFRASTRUCTURE
# ════════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=octo
POSTGRES_PASSWORD=change_me_in_production          # REQUERIDO — sin default
POSTGRES_DB=octo
# Construida a partir de las 3 variables anteriores:
DATABASE_URL=postgresql://octo:change_me_in_production@postgres:5432/octo
DB_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Opcional: proteger Redis con password (recomendado en producción)
# Si se setea, actualizar REDIS_URL a redis://:PASSWORD@redis:6379
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10

# ════════════════════════════════════════════════════════════════
# CONTROL PLANE — NestJS API (apps/api)
# ════════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# ── Auth ─────────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
JWT_SECRET=change_me_min_32_chars_openssl_rand_hex_32   # REQUERIDO — sin default
JWT_EXPIRES_IN=24h

# ── LiteLLM ──────────────────────────────────────────────────────
LITELLM_BASE_URL=http://litellm:4000
# Generar: openssl rand -hex 16
LITELLM_MASTER_KEY=change_me_min_16_chars              # REQUERIDO — sin default

# ── Runtime Worker inter-service secret ──────────────────────────
# Generar: openssl rand -hex 32
# DEBE coincidir exactamente con API_INTERNAL_SECRET del runtime-worker
RUNTIME_API_SECRET=change_me_min_32_chars_openssl_rand_hex_32  # REQUERIDO — sin default

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=https://tu-dominio.com

# ════════════════════════════════════════════════════════════════
# EXECUTION PLANE — Python Runtime Worker (apps/runtime-worker)
# ════════════════════════════════════════════════════════════════
WORKER_PORT=8000
WORKER_LOG_LEVEL=INFO
LOG_FORMAT=json

# Inter-service — DEBE ser el mismo valor que RUNTIME_API_SECRET
# El campo en pydantic-settings se llama api_internal_secret (env: API_INTERNAL_SECRET)
# El compose mapea RUNTIME_API_SECRET → API_INTERNAL_SECRET automáticamente.
API_URL=http://api:3001/api

# LiteLLM — mismo valor que LITELLM_MASTER_KEY de la API
# El compose mapea LITELLM_MASTER_KEY → LITELLM_API_KEY automáticamente.
OTEL_SERVICE_NAME_WORKER=octo-runtime-worker

# ── Execution limits ─────────────────────────────────────────────
MAX_CONCURRENT_EXECUTIONS=10
EXECUTION_TIMEOUT_SECS=300
MAX_EXECUTION_TIMEOUT_MS=300000

# ════════════════════════════════════════════════════════════════
# OBSERVABILITY — OpenTelemetry
# ════════════════════════════════════════════════════════════════
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=octo-api
OTEL_ENABLED=true

# ════════════════════════════════════════════════════════════════
# BUILD INFO — inyectado por CI / Coolify en build time
# En Coolify: Configuration → Build → Build Arguments
# ════════════════════════════════════════════════════════════════
BUILD_VERSION=0.1.0-f0
BUILD_COMMIT=unknown
BUILD_PHASE=F0
BUILD_TIME=unknown

# ════════════════════════════════════════════════════════════════
# LLM PROVIDERS — para LiteLLM proxy
# Al menos uno debe estar configurado para que el runtime-worker
# pueda ejecutar tareas LLM.
# ════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
