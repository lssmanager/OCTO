# .env.example -- COMMIT THIS FILE. Never commit .env
# Copy to .env for deployable/runtime configuration. Never put real values here.
# For local development, copy .env.local.example instead and keep it out of deploy targets.
#
# ADR-0016: Secrets are injected at runtime, never at build time.
# In Coolify: Service -> Environment Variables -> Secret (encrypted)

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=octo
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=octo
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Least-privilege role used only by apps/runtime-worker for F1 durable progress.
# Bootstrap with: DATABASE_URL=... RUNTIME_POSTGRES_PASSWORD=... bash scripts/bootstrap-runtime-db-role.sh
RUNTIME_POSTGRES_USER=octo_runtime
RUNTIME_POSTGRES_PASSWORD=replace-with-strong-runtime-postgres-password
RUNTIME_DATABASE_URL=postgresql://${RUNTIME_POSTGRES_USER}:${RUNTIME_POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ── Redis / BullMQ (transient queue only -- not source of truth) ───────────────
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
RUNTIME_WORKER_PORT=8001

# ── OTel / Observability ──────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=octo-api
OTEL_ENVIRONMENT=development

# ── LLM Provider (via LiteLLM -- never raw vendor SDK) ────────────────────────
LITELLM_MASTER_KEY=sk-change-me
OPENAI_API_KEY=sk-change-me

# ── Auth ──────────────────────────────────────────────────────────────────────
# Production must configure JWT_SIGNING_KEYS with an explicit active key and kid.
# Prefer RS256/JWKS per ADR-F1-005; this example stays commented because real key
# material must be provisioned privately at runtime:
# JWT_SIGNING_KEYS=[{"kid":"api-2026-06","algorithm":"RS256","isActive":true,"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}]
# JWT_SECRET remains available only as a non-production fallback when
# JWT_SIGNING_KEYS is unset. This published placeholder is rejected in production.
JWT_SECRET=change-me-in-production-min-32-chars
# Canonical internal/admin and inter-service secret. Required by API, workers,
# and BullBoard. Must be the same value everywhere and at least 32 chars.
INTERNAL_SECRET=replace-with-strong-internal-secret-min-32-chars

# ── Qdrant (vector memory) ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-strong-qdrant-api-key

# ── MinIO (blob storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace-with-strong-minio-access-key
MINIO_SECRET_KEY=replace-with-strong-minio-secret-key
