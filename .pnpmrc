# pnpm configuration — separated from .npmrc per pnpm 11 best practices
# https://pnpm.io/settings

publish-branch=main
link-workspace-packages=true
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=true

# F1 supply-chain release gate: wait at least 24h before installing newly published packages.
minimum-release-age=1440
